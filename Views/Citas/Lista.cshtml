@model List<Cita>
@{
    ViewData["Title"] = "Citas agendadas";
}

<section id="citasAgendadas">
    <h3>Citas agendadas</h3>

    @if (Model.Count == 0)
    {
        <p>Aún no hay citas agendadas.</p>
    }
    else
    {
        <p>Citas agendadas: @Model.Count | Total a pagar: $@ViewBag.Total</p>

        <div class="row">
            @foreach (var cita in Model)
            {
                <div class="col-12 col-md-4 mb-3">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">@cita.Nombre</h5>
                            <p class="card-text mb-1">Actividad: @cita.NombreActividad()</p>
                            <p class="card-text mb-1">Fecha: @cita.Fecha.ToString("dd/MM/yyyy")</p>
                            <p class="card-text fw-bold">Precio: $@cita.Precio()</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>

<a asp-controller="Citas" asp-action="Index" class="btn btn-danger">Agendar cita</a>